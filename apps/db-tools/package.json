{
  "name": "@lintel/db-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lintel Design OS database operations: the production migration runner (G6) and organization initialisation (G4). Its own deployable tool, independent of the API and of Lintel Ops.",
  "scripts": {
    "migrate": "node --import tsx src/migrate-cli.ts",
    "org": "node --import tsx src/org-cli.ts",
    "intake": "node --import tsx src/intake/intake-cli.ts"
  },
  "dependencies": {
    "@lintel/catalog-engine": "workspace:*",
    "@lintel/hettich-engine": "workspace:*",
    "@lintel/persistence": "workspace:*",
    "@lintel/types": "workspace:*",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
