{
  "name": "lintel-design-os",
  "private": true,
  "description": "Lintel Design OS — design-to-execution platform (monorepo).",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden:update": "UPDATE_GOLDEN=1 vitest run tests/golden",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lintel/bom-engine": "workspace:*",
    "@lintel/boq-engine": "workspace:*",
    "@lintel/catalog-engine": "workspace:*",
    "@lintel/design-engine": "workspace:*",
    "@lintel/geometry-engine": "workspace:*",
    "@lintel/hettich-engine": "workspace:*",
    "@lintel/pricing-engine": "workspace:*",
    "@lintel/rules-engine": "workspace:*",
    "@lintel/types": "workspace:*",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
