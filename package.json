{
  "name": "lintel-design-os",
  "private": true,
  "description": "Lintel Design OS — design-to-execution platform (monorepo).",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden:update": "UPDATE_GOLDEN=1 vitest run tests/golden",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:schema:update": "UPDATE_SCHEMA_SNAPSHOT=1 vitest run --config vitest.db.config.ts tests/db/migrations.test.ts",
    "engines:manifest": "pnpm --filter @lintel/api run engines:manifest",
    "api:openapi": "pnpm --filter @lintel/api run openapi"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lintel/bom-engine": "workspace:*",
    "@lintel/boq-engine": "workspace:*",
    "@lintel/catalog-engine": "workspace:*",
    "@lintel/design-engine": "workspace:*",
    "@lintel/drawing-engine": "workspace:*",
    "@lintel/geometry-engine": "workspace:*",
    "@lintel/hettich-engine": "workspace:*",
    "@lintel/persistence": "workspace:*",
    "@lintel/pricing-engine": "workspace:*",
    "@lintel/rules-engine": "workspace:*",
    "@lintel/storage": "workspace:*",
    "@lintel/types": "workspace:*",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "pg": "^8.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
